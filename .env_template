# ==========================================
# CONFIGURAÇÕES DE SEGURANÇA E ACESSO
# ==========================================

PORTEIRO_USER=seu_usuario # Nome para montar o Basic Auth n8n
PORTEIRO_PASS=sua_senha # Senha do Basic Auth no n8n
# 1. Chave de criptografia do banco de dados do n8n (Crie uma senha forte)
N8N_ENCRYPTION_KEY=sua_chave_secreta_aqui
# "Pós primeira instalação não altere esta chave, pois o n8n ira assumir a primeira chave pós inicialização/instalação dos processos"

# 2. Token de Autenticação do Ngrok (Pegue no seu painel do ngrok.com)

NGROK_AUTHTOKEN=seu_token_do_ngrok_aqui

# URL pública do túnel. Deixe vazio: o orquestrador (iniciar_servicos.ps1)
# preenche quando o ngrok sobe e reinjeta como WEBHOOK_URL do n8n.
NGROK_REMOTE_URL=

# 3. Token partilhado n8n <-> Porteiro (rotas /n8n/aprovar e /n8n/bloquear)
# Mesmo valor no node Configuracoes do workflow de aprovacao (admin_token)
PORTEIRO_TOKEN=seu_token_porteiro_aqui

# ==========================================
# SCOUT GATE (camada OSINT / MITM na borda)
# ==========================================
# USE_SCOUT=0 → Ngrok aponta directo para o Porteiro (:5677)
# USE_SCOUT=1 → Ngrok → Scout → Porteiro (recomendado)

USE_SCOUT=1
SCOUT_PUBLIC_PORT=4050
SCOUT_ADMIN_PORT=8765
SCOUT_UPSTREAM_HOST=host.docker.internal
SCOUT_UPSTREAM_PORT=5677
SCOUT_DEFAULT_ROUTE_MODE=tcp
SCOUT_LISTEN_PORT_START=4050
SCOUT_ENFORCE_FIREWALL=0
SCOUT_NGROK_TUNNEL_URL=
SCOUT_BACKEND_URL=ws://127.0.0.1:8765/ws

# Opcional — pasta de dados do Porteiro (por defeito: n8n/storage/Porteiro relativo ao projeto)
# PORTEIRO_DATA_DIR=
!n8n/storage/Porteiro/.gitkeep
n8n/storage/Porteiro/controle_acesso.json
n8n/storage/Porteiro/*.log
*.sqlite*
*.log
Porteiro/banco_acesso.db
.DS_Store
Thumbs.db
Scout_OSINT_Docker/.venv/
Scout_OSINT_Docker/data/
Scout_OSINT_Docker/.env
.porteiro.pid
# Login, diagnóstico, backup e cache de versão do Control Plane.
.n8groker/
.n8groker.supervisor.lock
.n8groker.shutdown.request
.n8groker.skip-control-plane-venv
.n8groker.control-plane.pid
.n8groker.control-plane-borda.pid
.venv/
venv/
control_plane.local.json
control_plane/.venv/
control_plane/.porteiro.cp.pid
__pycache__/
*.pyc
.psscriptanalyzer-cache/

# Understand-Anything: rascunho local. O grafo commitado fica em .ua/
.ua/intermediate/
.ua/diff-overlay.json
Arquivos-n8n/*
!Arquivos-n8n/.gitkeep
!Arquivos-n8n/README.md


# Referência — o Scout usa o .env na raiz do N8Groker (../.env).
# Copie ../.env_template para ../.env e preencha as variáveis abaixo.

# Ngrok aponta para Scout (porta MITM — não usar 4040, reservada à API do Ngrok)
SCOUT_PUBLIC_PORT=4050

# Upstream Porteiro (fora do Docker)
# Windows Docker Desktop: host.docker.internal
# Linux host network: 127.0.0.1
SCOUT_UPSTREAM_HOST=host.docker.internal
SCOUT_UPSTREAM_PORT=5677
SCOUT_DEFAULT_ROUTE_MODE=tcp

# Metadados (preenchido automaticamente pelo iniciar_servicos.ps1)
SCOUT_NGROK_TUNNEL_URL=https://xxxx.ngrok-free.app

# Pool de portas listen para novas rotas Docker
SCOUT_LISTEN_PORT_START=4050

# API admin + GUI
SCOUT_ADMIN_PORT=8765
SCOUT_BACKEND_URL=ws://127.0.0.1:8765/ws

# Persistência (dentro do container)
SCOUT_DATA_DIR=/app/data

# Firewall Linux (DOCKER-USER) — 0 no Windows, 1 em Linux host network
SCOUT_ENFORCE_FIREWALL=0

USE_SCOUT=1
SCOUT_BACKEND=1

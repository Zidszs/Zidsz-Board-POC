# ==========================================
# N8Groker — modelo de configuração
# ==========================================
# Copie para .env só se for editar à mão. O caminho normal é o Setup,
# que chama scripts/init_env.py e troca cada __GENERATE_*__ por um segredo
# aleatório. Não commite o .env. Não coloque chave de provider de LLM aqui:
# modelo e credencial de OpenAI/Anthropic/Ollama entram pela UI do LiteLLM.

# ==========================================
# SEGURANÇA E ACESSO (stack já existente)
# ==========================================

PORTEIRO_USER=seu_usuario
PORTEIRO_PASS=sua_senha

# Chave do banco do n8n. Depois do primeiro boot, não troque.
N8N_ENCRYPTION_KEY=__GENERATE_HEX_32__

# Token do painel ngrok.com — o Setup não inventa este valor.
NGROK_AUTHTOKEN=seu_token_do_ngrok_aqui

# URL pública do túnel. Deixe vazio: o orquestrador (iniciar_servicos.ps1)
# define NGROK_REMOTE_URL no processo quando o ngrok sobe e reinjeta como
# WEBHOOK_URL do n8n. A URL gravada no .env é SCOUT_NGROK_TUNNEL_URL.
# Não preencher à mão.
NGROK_REMOTE_URL=

# Tokens de aprovação não ficam neste arquivo. O Scout monta o .env no container.
# O iniciar_servicos.ps1 grava .n8groker/porteiro-painel.token (aba Admin)
# e .n8groker/porteiro-n8n.token (workflow do n8n).

# ==========================================
# SCOUT GATE
# ==========================================
# USE_SCOUT=0 → Ngrok aponta direto para o Porteiro (:5677)
# USE_SCOUT=1 → Ngrok → Scout → Porteiro

USE_SCOUT=1

# Lista de stacks que sobem junto com o núcleo no iniciar_servicos.ps1.
# Vazio (padrão) = só o núcleo: Porteiro, Scout (se USE_SCOUT=1), ngrok,
# painel em 8501, borda em 8502 e a rede Docker rede_comunicacao.
# n8n e a stack LLM (LiteLLM + Langfuse) ficam de fora e sobem pelo console
# ou por: .\iniciar_servicos.ps1 -Stack n8n
#          .\iniciar_servicos.ps1 -Stack llm -Acao parar
#          .\iniciar_servicos.ps1 -Stack llm -Acao reiniciar
# Comportamento antigo (subir as apps no mesmo boot): n8n,llm
# Token desconhecido é avisado e ignorado. O botão «Iniciar núcleo» não lê isto.
STACKS_BOOT=

# Validade do JWT de usuário emitido na aba Admin, em horas.
# Padrão 8. Abaixo de 0,25 vira 0,25. Acima de 168 vira 168.
# Não é senha e não é a chave: a chave fica em .n8groker/usuario.key.
N8GROKER_TOKEN_USUARIO_HORAS=8

SCOUT_PUBLIC_PORT=4050
SCOUT_ADMIN_PORT=8765
SCOUT_UPSTREAM_HOST=host.docker.internal
SCOUT_UPSTREAM_PORT=5677
SCOUT_DEFAULT_ROUTE_MODE=tcp
SCOUT_LISTEN_PORT_START=4050
SCOUT_ENFORCE_FIREWALL=0
SCOUT_NGROK_TUNNEL_URL=
SCOUT_BACKEND_URL=ws://127.0.0.1:8765/ws

# ==========================================
# LANGFUSE (UI em http://localhost:3000)
# ==========================================
# Headless init cria org, projeto, usuário e as chaves do LiteLLM no primeiro boot.
# Se o banco já subiu uma vez, mudar a chave aqui não regrava o projeto.

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=__GENERATE_HEX_32__
SALT=__GENERATE_HEX_16__
ENCRYPTION_KEY=__GENERATE_HEX_32__
TELEMETRY_ENABLED=false

LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=__GENERATE_ALNUM_32__
LANGFUSE_DB_NAME=langfuse

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=__GENERATE_ALNUM_24__

REDIS_AUTH=__GENERATE_ALNUM_32__

MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=__GENERATE_ALNUM_24__

LANGFUSE_INIT_ORG_ID=n8groker
LANGFUSE_INIT_ORG_NAME=N8Groker
LANGFUSE_INIT_PROJECT_ID=n8groker
LANGFUSE_INIT_PROJECT_NAME=N8Groker
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=__GENERATE_ALNUM_24__

# Par usado pelo Langfuse (init) e pelo LiteLLM (callback langfuse_otel).
LANGFUSE_PUBLIC_KEY=__GENERATE_PK_LF__
LANGFUSE_SECRET_KEY=__GENERATE_SK_LF__

# ==========================================
# LITELLM (UI em http://localhost:4000/ui)
# ==========================================
# Sem modelo pré-cadastrado. Login da UI: usuário abaixo + senha, ou a master key.
# Providers (OpenAI, Ollama, etc.) são configurados na interface.

LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=__GENERATE_ALNUM_32__
LITELLM_DB_NAME=litellm
LITELLM_MASTER_KEY=__GENERATE_LITELLM_MASTER__
LITELLM_SALT_KEY=__GENERATE_LITELLM_SALT__
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=__GENERATE_ALNUM_24__

# Sobe o Ollama deste Windows se ele estiver instalado e parado.
# 0 = nao mexe no programa local (util quando o modelo aponta para outra maquina).
# O script nao grava modelo nem endereco no LiteLLM. Isso continua na UI.
USE_OLLAMA_LOCAL=1

# Chat de suporte do Control Plane. Nao cadastra modelo no LiteLLM.
OLLAMA_BASE_URL=http://localhost:11434
SUPPORT_CHAT_MODEL=qwen2.5:7b-instruct

# Credencial OpenAI do n8n (tipo openAiApi): base URL do proxy na rede Docker.
# O init_env preenche com a mesma LITELLM_MASTER_KEY. Não edite à mão se puder evitar.
N8N_CREDENTIALS_OVERWRITE_DATA=__GENERATE_N8N_OVERWRITE__

# Nodes que quem chega no n8n não pode usar. Lista separada por vírgula.
# O iniciar_servicos.ps1 transforma isto no NODES_EXCLUDE (array JSON) que a
# imagem realmente lê. N8N_NODES_EXCLUDE dentro do container é ignorado.
# Vale a instância inteira, inclusive o editor em localhost:5678. Para
# reativar um node, apague o nome e recrie o container. O node Code não está
# na lista: os fluxos do dia a dia usam JavaScript dentro do n8n.
# N8N_BLOCK_ENV_ACCESS_IN_NODE fica de fora porque o workflow de aprovação
# lê {{ $env.PORTEIRO_N8N_TOKEN }}.
N8N_NODES_EXCLUDE=n8n-nodes-base.executeCommand,n8n-nodes-base.ssh,n8n-nodes-base.readWriteFile,n8n-nodes-base.localFileTrigger,n8n-nodes-base.readBinaryFile,n8n-nodes-base.readBinaryFiles,n8n-nodes-base.writeBinaryFile
